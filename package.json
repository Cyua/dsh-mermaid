{
  "name": "@cyua/dsh-mermaid",
  "version": "0.1.0",
  "description": "Render fenced Mermaid code blocks in the DeepSeek Harness Web UI as theme-aware diagrams.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "mermaid",
    "diagram",
    "markdown"
  ],
  "author": "Cyua",
  "license": "MIT",
  "homepage": "https://github.com/Cyua/dsh-mermaid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyua/dsh-mermaid.git"
  },
  "bugs": {
    "url": "https://github.com/Cyua/dsh-mermaid/issues"
  },
  "private": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/",
    "index.js",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:debug": "node build.mjs --debug",
    "prepare": "node build.mjs",
    "verify": "node tools/check-release.mjs",
    "check": "node --check src/client.js && node build.mjs && node tools/check-release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "mermaid": "^12.3.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
